[Unit]
Description=AI Forecast Terminal
After=network.target

[Service]
User=willo
WorkingDirectory=/home/willo/forecast
# Ключ для ИИ-аналитика: строка ANTHROPIC_API_KEY=... в этом файле (права 600)
EnvironmentFile=-/home/willo/forecast/.env
Environment=PYTHONIOENCODING=utf-8
ExecStart=/home/willo/forecast/.venv/bin/python -m uvicorn forecast.api.app:app --app-dir backend --host 0.0.0.0 --port 8003
Restart=always

[Install]
WantedBy=multi-user.target
